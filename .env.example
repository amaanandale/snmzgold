# SNMZ Gold & Diamonds — Environment Variables
# Copy this file to .env.local and fill in the values.
# Never commit .env.local to version control.

# ── Site URL ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://snmzgold.com

# ── Contact ───────────────────────────────────────────────────────────────────
# WhatsApp: UAE country code + number, no + sign, no spaces
# Example: 971501234567
NEXT_PUBLIC_WHATSAPP=

NEXT_PUBLIC_EMAIL=
NEXT_PUBLIC_PHONE=

# ── News API ──────────────────────────────────────────────────────────────────
# GNews API key — used for /gold-news and /economic-news pages.
# Register free at: https://gnews.io/
# Free tier: 100 requests/day, 10 articles per response.
# Server-side only — do NOT add NEXT_PUBLIC_ prefix.
GNEWS_API_KEY=
